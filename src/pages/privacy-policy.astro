---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { privacyPolicy } from '../content/privacy-policy'
import '../styles/policy.css'
---

<Layout
  title='Privacy Policy - Aspirare'
  description='Privacy Policy for Aspirare - Learn how we protect and handle your personal information.'
>
  <Header />
  <main class='policy-page'>
    <div class='container'>
      <div class='policy-content'>
        <div class='policy-header'>
          <h1 class='policy-title'>{privacyPolicy.title}</h1>
          <p class='policy-subtitle'>
            Last updated: {privacyPolicy.lastUpdated}
          </p>
        </div>

        <div class='policy-body'>
          {
            privacyPolicy.sections.map((section) => (
              <section class='policy-section'>
                <h2>{section.title}</h2>
                {section.body.map((item) =>
                  Array.isArray(item) ? (
                    <ul>
                      {item.map((li) => (
                        <li>{li}</li>
                      ))}
                    </ul>
                  ) : (
                    <p>{item}</p>
                  )
                )}
                {section.contact && (
                  <div class='contact-info'>
                    <p>
                      <strong>Email:</strong> {section.contact.email}
                    </p>
                  </div>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
