---
export interface Props {
  title?: string
  description?: string
}

const {
  title = 'Aspirare - Enterprise AI Transformation',
  description = 'Strategic AI implementation for enterprise companies. Drive efficiency, reduce costs, and unlock revenue with our proven AI transformation methodology.'
} = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src='https://www.googletagmanager.com/gtag/js?id=G-LNHTPB8227'
    ></script>
    <script>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())

      gtag('config', 'G-LNHTPB8227')
    </script>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content={description} />
    <title>{title}</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&display=swap'
      rel='stylesheet'
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* IBM Carbon Design System color tokens */
    --color-interactive: #0f62fe; /* blue 60 */
    --color-interactive-hover: #0050e6;
    --color-interactive-active: #002d9c; /* blue 80 */
    --color-link: #0f62fe;
    --color-link-hover: #0043ce; /* blue 70 */
    --color-blue-40: #78a9ff;
    --color-blue-20: #d0e2ff;
    --color-blue-10: #edf5ff;
    --color-text-primary: #161616; /* gray 100 */
    --color-text-secondary: #525252; /* gray 70 */
    --color-text-helper: #6f6f6f; /* gray 60 */
    --color-text-on-color: #ffffff;
    --color-background: #ffffff;
    --color-background-hover: rgba(141, 141, 141, 0.12);
    --color-layer: #f4f4f4; /* gray 10 */
    --color-layer-hover: #e8e8e8;
    --color-border-subtle: #e0e0e0; /* gray 20 */
    --color-border-tile: #c6c6c6; /* gray 30 */
    --color-dark-background: #161616;
    --color-dark-layer: #262626; /* gray 90 */
    --color-dark-border: #393939; /* gray 80 */
    --color-dark-text-primary: #f4f4f4;
    --color-dark-text-secondary: #c6c6c6;
    --color-dark-text-helper: #a8a8a8; /* gray 40 */
    --color-white: #ffffff;

    /* Carbon spacing scale (8px mini-unit) */
    --spacing-02: 0.25rem; /* 4px */
    --spacing-03: 0.5rem; /* 8px */
    --spacing-04: 0.75rem; /* 12px */
    --spacing-05: 1rem; /* 16px */
    --spacing-06: 1.5rem; /* 24px */
    --spacing-07: 2rem; /* 32px */
    --spacing-08: 2.5rem; /* 40px */
    --spacing-09: 3rem; /* 48px */
    --spacing-10: 4rem; /* 64px */
    --spacing-11: 5rem; /* 80px */
    --spacing-12: 6rem; /* 96px */

    /* Carbon motion */
    --ease-standard: cubic-bezier(0.2, 0, 0.38, 0.9);
    --ease-entrance: cubic-bezier(0, 0, 0.38, 0.9);

    --header-height: 3rem; /* 48px masthead */
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-padding-top: var(--header-height);
  }

  html,
  body {
    font-family:
      'IBM Plex Sans',
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Helvetica Neue',
      Arial,
      sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-primary);
    background-color: var(--color-background);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--color-blue-20);
    color: var(--color-text-primary);
  }

  /* IBM type: large headings are Light (300), small headings SemiBold (600) */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-text-primary);
    font-weight: 400;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 300;
    line-height: 1.19;
  }
  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.625rem);
    font-weight: 300;
    line-height: 1.2;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.4;
  }
  h4 {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.43;
    letter-spacing: 0.16px;
  }

  p {
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .container {
    max-width: 82rem; /* 1312px — Carbon xlg breakpoint */
    margin: 0 auto;
    padding: 0 var(--spacing-05);
  }

  /* Section eyebrow label — signature IBM pattern */
  .eyebrow {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.16px;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-05);
  }

  /* Carbon button: sharp corners, left-aligned text, icon pinned right */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-07);
    height: 3rem;
    padding: 0 0.9375rem;
    max-width: 20rem;
    border: 1px solid transparent;
    border-radius: 0;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.16px;
    line-height: 1.28572;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 70ms var(--ease-entrance),
      border-color 70ms var(--ease-entrance),
      color 70ms var(--ease-entrance);
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn:focus-visible {
    border-color: var(--color-interactive);
    box-shadow:
      inset 0 0 0 1px var(--color-interactive),
      inset 0 0 0 2px var(--color-white);
    outline: none;
  }

  .btn svg {
    flex-shrink: 0;
  }

  .btn-primary {
    background: var(--color-interactive);
    color: var(--color-text-on-color);
  }

  .btn-primary:hover {
    background: var(--color-interactive-hover);
    color: var(--color-text-on-color);
  }

  .btn-primary:active {
    background: var(--color-interactive-active);
  }

  /* Carbon tertiary button */
  .btn-secondary {
    background: transparent;
    color: var(--color-interactive);
    border: 1px solid var(--color-interactive);
  }

  .btn-secondary:hover {
    background: var(--color-interactive-hover);
    border-color: var(--color-interactive-hover);
    color: var(--color-text-on-color);
  }

  .btn-secondary:active {
    background: var(--color-interactive-active);
    border-color: var(--color-interactive-active);
  }

  .section {
    padding: var(--spacing-11) 0;
  }

  .section-alt {
    background: var(--color-layer);
  }

  .fade-in {
    opacity: 0;
    transform: translateY(12px);
    animation: fadeInUp 0.5s var(--ease-entrance) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: var(--spacing-09) 0;
    }
  }
</style>
