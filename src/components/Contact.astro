---
import { siteContent } from '../content/site'
const { contact } = siteContent
---

<section id='contact' class='section section-alt'>
  <div class='container'>
    <div class='contact-content'>
      <div class='contact-intro'>
        <p class='eyebrow fade-in'>Contact</p>
        <h2 class='section-title fade-in'>{contact.title}</h2>
        <p class='section-subtitle fade-in'>{contact.subtitle}</p>
      </div>

      <div class='contact-info fade-in'>
        <div class='info-card'>
          <h3 class='info-title'>Get in Touch</h3>
          <p class='info-description'>
            Our team of experts is ready to discuss your specific needs and
            challenges.
          </p>

          <div class='info-items'>
            <div class='info-item'>
              <svg
                class='info-icon'
                width='20'
                height='20'
                viewBox='0 0 20 20'
                fill='none'
                stroke='currentColor'
                stroke-width='1.25'
                aria-hidden='true'
              >
                <path
                  d='M10 18s6-5.1 6-9.6A6.1 6.1 0 0 0 10 2a6.1 6.1 0 0 0-6 6.4C4 12.9 10 18 10 18z'
                ></path>
                <circle cx='10' cy='8.2' r='2.2'></circle>
              </svg>
              <div class='info-content'>
                <div class='info-label'>Address</div>
                <div class='info-value'>{contact.info.address}</div>
              </div>
            </div>

            <div class='info-item'>
              <svg
                class='info-icon'
                width='20'
                height='20'
                viewBox='0 0 20 20'
                fill='none'
                stroke='currentColor'
                stroke-width='1.25'
                aria-hidden='true'
              >
                <path
                  d='M13.6 12.2l-1.8 1.8a14.5 14.5 0 0 1-5.8-5.8l1.8-1.8L5.6 2.2 3 3.4C3 11 9 17 16.6 17l1.2-2.6-4.2-2.2z'
                ></path>
              </svg>
              <div class='info-content'>
                <div class='info-label'>Phone</div>
                <div class='info-value'>{contact.info.phone}</div>
              </div>
            </div>

            <div class='info-item'>
              <svg
                class='info-icon'
                width='20'
                height='20'
                viewBox='0 0 20 20'
                fill='none'
                stroke='currentColor'
                stroke-width='1.25'
                aria-hidden='true'
              >
                <rect x='2' y='4' width='16' height='12'></rect>
                <path d='M2 5l8 6 8-6'></path>
              </svg>
              <div class='info-content'>
                <div class='info-label'>Email</div>
                <div class='info-value'>{contact.info.email}</div>
              </div>
            </div>
          </div>

          <div class='cta-buttons'>
            <a href={`mailto:${contact.info.email}`} class='btn btn-primary'>
              Send Email
              <svg
                width='16'
                height='16'
                viewBox='0 0 16 16'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
                aria-hidden='true'
              >
                <path d='M1 8h13M9 3l5 5-5 5'></path>
              </svg>
            </a>
            <a
              href={`tel:${contact.info.phone.replace(/\D/g, '')}`}
              class='btn btn-secondary'
            >
              Call Now
              <svg
                width='16'
                height='16'
                viewBox='0 0 16 16'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
                aria-hidden='true'
              >
                <path d='M1 8h13M9 3l5 5-5 5'></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-10);
    align-items: start;
  }

  .section-title {
    margin-bottom: var(--spacing-05);
  }

  .section-subtitle {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-text-secondary);
    max-width: 30rem;
  }

  .info-card {
    background: var(--color-background);
    outline: 1px solid var(--color-border-tile);
    padding: var(--spacing-07) var(--spacing-06);
  }

  .info-title {
    margin-bottom: var(--spacing-03);
  }

  .info-description {
    font-size: 0.875rem;
    line-height: 1.43;
    letter-spacing: 0.16px;
    margin-bottom: var(--spacing-06);
  }

  .info-items {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--spacing-07);
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-05);
    padding: var(--spacing-05) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .info-item:last-child {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .info-icon {
    color: var(--color-text-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-label {
    font-size: 0.75rem;
    letter-spacing: 0.32px;
    color: var(--color-text-helper);
    margin-bottom: var(--spacing-02);
  }

  .info-value {
    font-size: 1rem;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
  }

  .cta-buttons .btn {
    flex: 1 1 0;
    min-width: 10rem;
  }

  @media (max-width: 1056px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-09);
    }

    .info-card {
      max-width: 36rem;
    }
  }

  @media (max-width: 480px) {
    .cta-buttons {
      flex-direction: column;
    }

    .cta-buttons .btn {
      flex: none;
      width: 100%;
    }
  }
</style>
