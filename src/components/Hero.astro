---
import { siteContent } from '../content/site'
const { hero, company } = siteContent
---

<section class='hero'>
  <div class='container'>
    <p class='hero-eyebrow fade-in'>{company.tagline}</p>
    <h1 class='hero-headline fade-in'>{hero.headline}</h1>
    <p class='hero-subheadline fade-in'>{hero.subheadline}</p>

    <div class='hero-cta fade-in'>
      <a href='#contact' class='btn btn-primary'>
        {hero.cta.primary}
        <svg
          width='16'
          height='16'
          viewBox='0 0 16 16'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
          aria-hidden='true'
        >
          <path d='M1 8h13M9 3l5 5-5 5'></path>
        </svg>
      </a>
      <a href='#case-studies' class='btn btn-secondary'>
        {hero.cta.secondary}
        <svg
          width='16'
          height='16'
          viewBox='0 0 16 16'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
          aria-hidden='true'
        >
          <path d='M1 8h13M9 3l5 5-5 5'></path>
        </svg>
      </a>
    </div>

    <div class='hero-metrics fade-in'>
      {
        hero.metrics.map((metric) => (
          <div class='metric'>
            <div class='metric-value'>{metric.value}</div>
            <div class='metric-label'>{metric.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* IBM leadspace: white, left-aligned, large Light (300) type */
  .hero {
    background: var(--color-background);
    padding-top: calc(var(--header-height) + var(--spacing-11));
    padding-bottom: var(--spacing-11);
  }

  .hero-eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.16px;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-05);
  }

  .hero-headline {
    max-width: 56rem;
    margin-bottom: var(--spacing-06);
  }

  .hero-subheadline {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 300;
    line-height: 1.34;
    color: var(--color-text-secondary);
    max-width: 40rem;
    margin-bottom: var(--spacing-09);
  }

  /* Carbon button pair: butted edge-to-edge, equal widths */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-11);
  }

  .hero-cta .btn {
    flex: 1 1 0;
    max-width: 20rem;
    min-width: 13rem;
  }

  /* Hairline-separated stat tiles */
  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
  }

  .metric {
    background: var(--color-background);
    outline: 1px solid var(--color-border-subtle);
    padding: var(--spacing-06) var(--spacing-05);
  }

  .metric-value {
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-interactive);
    margin-bottom: var(--spacing-03);
  }

  .metric-label {
    font-size: 0.875rem;
    letter-spacing: 0.16px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--header-height) + var(--spacing-09));
      padding-bottom: var(--spacing-09);
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-cta .btn {
      flex: none;
      max-width: 20rem;
      width: 100%;
    }

    .hero-metrics {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
