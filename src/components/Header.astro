---
import { Image } from 'astro:assets'
import logo from '../assets/images/logo.png'
// Get current page path to determine if we're on a policy page
const currentPath = Astro.url.pathname
const isHomePage = currentPath === '/'
const baseUrl = isHomePage ? '' : '/'
---

<header class='header'>
  <nav class='nav' aria-label='Main navigation'>
    <div class='nav-content'>
      <div class='logo'>
        <a href='/' class='logo-link'>
          <Image
            id='nav-bg'
            src={logo}
            aria-hidden
            alt='logo'
            style='width: 120px; height: 28px;'
          />
        </a>
      </div>

      <div class='nav-links' id='nav-links'>
        <a href={`${baseUrl}#services`} class='nav-link'>Services</a>
        <a href={`${baseUrl}#about`} class='nav-link'>About</a>
        <a href={`${baseUrl}#case-studies`} class='nav-link'>Case Studies</a>
        <a href={`${baseUrl}#contact`} class='nav-link'>Contact</a>
        <a href={`${baseUrl}#contact`} class='btn btn-primary nav-cta'
          >Get Started</a
        >
      </div>

      <button
        class='mobile-menu-btn'
        id='mobile-menu-btn'
        aria-label='Toggle menu'
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  /* IBM masthead: 48px, solid white, 1px hairline bottom border */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 8000;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border-subtle);
    height: var(--header-height);
  }

  .nav-content {
    display: flex;
    align-items: center;
    height: calc(var(--header-height) - 1px);
    padding-left: var(--spacing-05);
  }

  .logo-link {
    display: flex;
    align-items: center;
    height: 100%;
    padding-right: var(--spacing-06);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    height: 100%;
    flex: 1;
  }

  .nav-link {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--spacing-05);
    font-size: 0.875rem;
    letter-spacing: 0.16px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      background-color 110ms var(--ease-standard),
      color 110ms var(--ease-standard);
  }

  .nav-link:hover {
    background: var(--color-background-hover);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: -2px;
  }

  /* CTA flush against the right edge of the masthead */
  .nav-cta {
    margin-left: auto;
    height: 100%;
    max-width: none;
    gap: var(--spacing-05);
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: var(--header-height);
    height: calc(var(--header-height) - 1px);
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 8001;
  }

  .mobile-menu-btn:hover {
    background: var(--color-background-hover);
  }

  .mobile-menu-btn span {
    width: 18px;
    height: 1.5px;
    background: var(--color-text-primary);
    transition: all 110ms var(--ease-standard);
    transform-origin: center;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(4.5px, 4.5px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(4.5px, -4.5px);
  }

  @media (max-width: 768px) {
    .nav-links {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      height: auto;
      background: var(--color-background);
      flex-direction: column;
      align-items: stretch;
      border-bottom: 1px solid var(--color-border-subtle);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition:
        transform 240ms var(--ease-standard),
        opacity 240ms var(--ease-standard),
        visibility 240ms var(--ease-standard);
    }

    .nav-links.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .nav-link {
      height: var(--header-height);
      border-top: 1px solid var(--color-border-subtle);
    }

    .nav-cta {
      margin-left: 0;
      height: var(--header-height);
      justify-content: flex-start;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn')
  const navLinks = document.getElementById('nav-links')

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenuBtn.classList.toggle('active')
    navLinks?.classList.toggle('active')
  })

  // Close mobile menu when clicking on a link
  document.querySelectorAll('.nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenuBtn?.classList.remove('active')
      navLinks?.classList.remove('active')
    })
  })

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    if (
      !mobileMenuBtn?.contains(e.target as Node) &&
      !navLinks?.contains(e.target as Node)
    ) {
      mobileMenuBtn?.classList.remove('active')
      navLinks?.classList.remove('active')
    }
  })

  // Enhanced navigation handling for both same-page and cross-page navigation
  document.querySelectorAll('a[href*="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href')
      if (!href) return

      // Check if it's a same-page anchor link
      if (href.startsWith('#')) {
        e.preventDefault()
        const target = document.querySelector(href)
        if (target) {
          const headerHeight = 48
          const targetPosition = target.offsetTop - headerHeight

          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          })
        }
      }
      // For cross-page navigation (like /#services from policy pages), let the browser handle it naturally
      // The browser will navigate to the page and then scroll to the anchor
    })
  })
</script>
