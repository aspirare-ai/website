---
import { siteContent } from '../content/site'
const { about } = siteContent
---

<section id='about' class='about'>
  <div class='container'>
    <div class='about-content'>
      <div class='about-text'>
        <p class='eyebrow about-eyebrow fade-in'>About</p>
        <h2 class='section-title fade-in'>{about.title}</h2>
        <p class='about-description fade-in'>{about.description}</p>

        <div class='expertise'>
          <h4 class='expertise-title fade-in'>Core Expertise</h4>
          <div class='expertise-grid'>
            {
              about.expertise.map((skill, index) => (
                <div
                  class='expertise-item fade-in'
                  style={`animation-delay: ${index * 0.1}s`}
                >
                  <svg
                    class='expertise-check'
                    width='16'
                    height='16'
                    viewBox='0 0 16 16'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.5'
                    aria-hidden='true'
                  >
                    <path d='M2 8.5l4 4L14 4' />
                  </svg>
                  {skill}
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class='about-stats'>
        {
          about.stats.map((stat, index) => (
            <div
              class='stat-card fade-in'
              style={`animation-delay: ${index * 0.15}s`}
            >
              <div class='stat-number'>{stat.number}</div>
              <div class='stat-label'>{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* IBM dark theme band (Gray 100) */
  .about {
    background: var(--color-dark-background);
    padding: var(--spacing-11) 0;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 25rem;
    gap: var(--spacing-10);
    align-items: start;
  }

  .about-text {
    max-width: 40rem;
  }

  .about-eyebrow {
    color: var(--color-dark-text-secondary);
  }

  .section-title {
    color: var(--color-dark-text-primary);
    margin-bottom: var(--spacing-06);
  }

  .about-description {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-dark-text-secondary);
    margin-bottom: var(--spacing-09);
  }

  .expertise-title {
    color: var(--color-dark-text-primary);
    margin-bottom: var(--spacing-05);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  .expertise-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-03);
    padding: var(--spacing-04) 0;
    font-size: 1rem;
    color: var(--color-dark-text-secondary);
    border-top: 1px solid var(--color-dark-border);
  }

  .expertise-item:last-child {
    border-bottom: 1px solid var(--color-dark-border);
  }

  .expertise-check {
    color: var(--color-blue-40);
    flex-shrink: 0;
  }

  /* Hairline-separated stat tiles on the dark layer */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
  }

  .stat-card {
    background: var(--color-dark-layer);
    outline: 1px solid var(--color-dark-border);
    padding: var(--spacing-06) var(--spacing-05);
    min-height: 9rem;
  }

  .stat-number {
    font-size: 2.625rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-blue-40);
    margin-bottom: var(--spacing-03);
  }

  .stat-label {
    font-size: 0.875rem;
    letter-spacing: 0.16px;
    color: var(--color-dark-text-secondary);
    line-height: 1.43;
  }

  @media (max-width: 1056px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-09);
    }
  }

  @media (max-width: 768px) {
    .about {
      padding: var(--spacing-09) 0;
    }

    .stat-card {
      min-height: 0;
    }

    .stat-number {
      font-size: 2.25rem;
    }
  }
</style>
