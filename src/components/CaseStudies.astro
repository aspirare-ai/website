---
import { siteContent } from '../content/site'
const { caseStudies } = siteContent
---

<section id='case-studies' class='section'>
  <div class='container'>
    <div class='section-header'>
      <p class='eyebrow fade-in'>Case studies</p>
      <h2 class='section-title fade-in'>{caseStudies.title}</h2>
      <p class='section-subtitle fade-in'>{caseStudies.subtitle}</p>
    </div>

    <div class='case-studies-grid'>
      {
        caseStudies.studies.map((study, index) => (
          <div
            class='case-study-card fade-in'
            style={`animation-delay: ${index * 0.2}s`}
          >
            <div class='study-header'>
              <div class='study-industry'>{study.industry}</div>
              <h3 class='study-company'>{study.company}</h3>
            </div>

            <div class='study-content'>
              <div class='study-block'>
                <h4 class='study-label'>Challenge</h4>
                <p>{study.challenge}</p>
              </div>

              <div class='study-block'>
                <h4 class='study-label'>Solution</h4>
                <p>{study.solution}</p>
              </div>

              <div class='study-block'>
                <h4 class='study-label'>Results</h4>
                <ul class='results-list'>
                  {study.results.map((result) => (
                    <li class='result-item'>
                      <svg
                        class='result-icon'
                        width='16'
                        height='16'
                        viewBox='0 0 16 16'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='1.5'
                        aria-hidden='true'
                      >
                        <path d='M1 8h13M9 3l5 5-5 5' />
                      </svg>
                      {result}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-header {
    margin-bottom: var(--spacing-09);
  }

  .section-title {
    margin-bottom: var(--spacing-05);
    max-width: 48rem;
  }

  .section-subtitle {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-text-secondary);
    max-width: 40rem;
  }

  /* Carbon card group on white: gray-10 tiles with hairline seams */
  .case-studies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1px;
  }

  .case-study-card {
    display: flex;
    flex-direction: column;
    background: var(--color-layer);
    outline: 1px solid var(--color-border-tile);
    padding: var(--spacing-05);
  }

  .study-header {
    padding-bottom: var(--spacing-05);
  }

  .study-industry {
    font-size: 0.875rem;
    letter-spacing: 0.16px;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-02);
  }

  .study-company {
    color: var(--color-text-primary);
  }

  .study-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .study-block {
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--spacing-05) 0;
  }

  .study-block:last-child {
    padding-bottom: 0;
    margin-top: auto;
  }

  .study-label {
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-03);
  }

  .study-block p {
    font-size: 0.875rem;
    line-height: 1.43;
    letter-spacing: 0.16px;
    color: var(--color-text-secondary);
  }

  .results-list {
    list-style: none;
  }

  .result-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-03);
    padding: var(--spacing-02) 0;
    font-size: 0.875rem;
    letter-spacing: 0.16px;
    line-height: 1.43;
    color: var(--color-text-primary);
  }

  .result-icon {
    color: var(--color-interactive);
    flex-shrink: 0;
    margin-top: 2px;
  }

  @media (max-width: 768px) {
    .case-studies-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
